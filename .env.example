# Copy to .env and fill in. Never commit .env.
# Every secret can instead be read from a file: NAME_FILE=/run/secrets/name

# --- SVN ----------------------------------------------------------------------
SVN_USERNAME=
SVN_PASSWORD=
# 1 = accept a server certificate that is not trusted by a public CA
SVN_TRUST_SERVER_CERT=0

# Repositories to scan: name=url, comma separated. Each name becomes a flag (--name).
VULNSCAN_REPOS=app_2026=https://svn.example.com/app/trunk,tools_2026=https://svn.example.com/tools/trunk

# --- Email (used with --email) --------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# comma separated
SMTP_TO=
SMTP_CC=
SMTP_SUBJECT_PREFIX=[vulnscan]
# reports larger than this are not attached (the email says where to find them)
SMTP_MAX_ATTACHMENT_MB=15

# --- Compose / Dockhand ---------------------------------------------------------
# image tag to run: an exact release (e.g. 1.2.3) to pin it, or a major version (e.g. 1) to follow updates
# (see https://github.com/CadworkNA/vulnscan/releases)
VULNSCAN_TAG=
# where reports are written on the host
VULNSCAN_REPORTS=./reports
# scheduled service: cron schedule (container time zone) and scan arguments
VULNSCAN_SCHEDULE=0 2 * * 1
VULNSCAN_ARGS=--all --email
TZ=America/Toronto
